{
  "name": "www",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "ZYX.tw — the actual website",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "previews": "uv run scripts/previews.py",
    "pictures": "node scripts/pixel/devices.mjs /tmp/zyx-pictures && uv run scripts/pixel/webp.py /tmp/zyx-pictures public/previews && uv run scripts/previews.py --dither-only",
    "og": "uv run scripts/og-image.py",
    "cv": "bun scripts/cv.ts",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "exifr": "^7.1.3",
    "lucide-react": "^1.11.0",
    "next": "16.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1",
    "@base-ui/react": "^1.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "motion": "^12.38.0",
    "react-icons": "^5.6.0",
    "shadcn": "^4.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "@monogrid/gainmap-js": "^3.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "postprocessing": "^6.39.5",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.2.0",
    "typescript-eslint": "^8.54.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "bun@1.4.5"
}
